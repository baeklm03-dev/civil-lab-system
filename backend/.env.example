# Server
PORT=5000
NODE_ENV=development

# JWT Secret (เปลี่ยนเป็น random string ยาวๆ ก่อน deploy)
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=8h

# Google Sheets API
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project-id.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END RSA PRIVATE KEY-----"

# Google Sheets IDs
USERS_SHEET_ID=your_users_google_sheet_id
WORKORDERS_SHEET_ID=your_workorders_google_sheet_id

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173
