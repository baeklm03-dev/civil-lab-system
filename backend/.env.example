# Server
PORT=5000
NODE_ENV=development

# JWT Secret (เปลี่ยนเป็น random string ยาวๆ ก่อน deploy)
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=8h

# บัญชี admin สำรอง (โหมด local, ไม่ผ่าน Google Sheets)
LOCAL_ADMIN_USERNAME=admin
LOCAL_ADMIN_NAME=ผู้ดูแลระบบ
LOCAL_ADMIN_ROLE=superadmin
LOCAL_ADMIN_PASSWORD_HASH=bcrypt_hash_here

# Google Sheets API — service account (อ่าน/เขียนข้อมูลในแอป)
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project-id.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END RSA PRIVATE KEY-----"

# Google OAuth — สำหรับอัปโหลดไฟล์ขึ้น Google Drive (เชื่อมต่อผ่าน /api/google-auth/connect)
GOOGLE_CLIENT_ID=your_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_oauth_client_secret
# ต้องตรงกับ Authorized redirect URI ที่ตั้งค่าไว้ใน Google Cloud Console และเป็น URL จริงของ backend ที่ deploy
GOOGLE_REDIRECT_URI=http://localhost:5000/api/google-auth/callback

# โฟลเดอร์ปลายทางบน Drive ที่จะสร้าง Sheet ใบรับงาน + อีเมลที่จะแชร์สิทธิ์แก้ไขให้อัตโนมัติ
DRIVE_FOLDER_ID=your_drive_folder_id
OWNER_EMAIL=someone@example.com

# Google Sheets IDs (ถ้าตั้งค่า จะสลับโมดูลนั้นไปใช้ Google Sheets แทนไฟล์ JSON ในเครื่อง — เว้นว่างไว้เพื่อใช้ local JSON)
SPREADSHEET_ID=
WORKORDERS_SHEET_ID=
USERS_SHEET_ID=
PERSONNEL_SHEET_ID=

# Frontend URL (for CORS) — ต้องเป็น URL จริงของ frontend ที่ deploy
FRONTEND_URL=http://localhost:5173
